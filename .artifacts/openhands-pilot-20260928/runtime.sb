(version 1)
(allow default)
(deny network*)
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:18763"))
(deny file-read* (subpath "/Users/jm"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/team2-openhands-pilot-20260928"))
(allow file-write* (literal "/dev/null"))
(deny mach-lookup)
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
